---
import StorefrontLayout from '../layouts/StorefrontLayout.astro';

// Mengambil subdomain dari context locals yang di-set oleh middleware
const subdomain = Astro.locals.subdomain || 'Tidak ada subdomain terdeteksi';
---

<StorefrontLayout title="Uji Coba Storefront">
  <div class="flex flex-col items-center justify-center py-20 bg-base-100 rounded-xl shadow-sm border border-base-200 mt-10">
    <h2 class="text-3xl font-bold mb-4">Fitur Subdomain & Layout Bekerja! 🎉</h2>
    <div class="bg-primary/10 p-6 rounded-lg text-center mb-6">
      <p class="text-lg text-base-content/80 mb-2">Subdomain yang terdeteksi oleh Middleware:</p>
      <p class="text-4xl font-mono font-bold text-primary">{subdomain}</p>
    </div>
    
    <p class="text-base-content/70 max-w-md text-center">
      Halaman ini menggunakan <strong>StorefrontLayout</strong>. Untuk menguji deteksi subdomain, coba akses URL di bawah ini di browser Anda:
    </p>
    
    <div class="mt-8 flex flex-col gap-3 w-full max-w-sm">
      <a href="http://tokobaju.localhost:4321/test-store" class="btn btn-outline btn-primary">Uji tokobaju.localhost:4321</a>
      <a href="http://warungkopi.localhost:4321/test-store" class="btn btn-outline btn-secondary">Uji warungkopi.localhost:4321</a>
      <a href="http://localhost:4321/test-store" class="btn btn-ghost">Tanpa Subdomain</a>
    </div>
  </div>
</StorefrontLayout>
