---
import '@/styles/global.css';
import Navbar from '@/components/common/Navbar.astro';
import ToastContainer from '@/components/ui/ToastContainer.svelte';
import RateLimitAlert from '@/components/ui/RateLimitAlert.svelte';

interface Props {
  title?: string;
  description?: string;
  hideNavbar?: boolean;
}

const {
  title = 'UMKM Site Builder',
  description = 'No-code SaaS for Indonesian micro-enterprises',
  hideNavbar = false,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    
    <!-- Anti-flicker theme script - runs before DOM renders -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body class="overflow-x-hidden">
    <ToastContainer client:load />
    <RateLimitAlert client:load />
    {!hideNavbar && <Navbar />}
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    height: 100%;
    width: 100%;
  }
</style>
