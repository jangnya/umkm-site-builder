---
import '@/styles/global.css';
import criticalCSS from '@/styles/critical.css?raw';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="LakuBase Storefront" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    {/* Inline critical CSS — blocks render until parsed (by design for LCP optimization) */}
    <style is:inline set:html={criticalCSS} />
    
    {/* Preconnect to external resources */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
