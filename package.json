{
  "name": "umkm-site-builder",
  "type": "module",
  "version": "0.0.1",
  "description": "No-code SaaS web builder for Indonesian UMKM",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src tests --ext .ts,.js,.astro,.svelte --max-warnings 0",
    "db:seed": "bun run src/db/seed.ts",
    "lint:fix": "eslint src tests --ext .ts,.js,.astro,.svelte --fix",
    "format": "prettier --write src",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@neondatabase/serverless": "^1.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "astro": "^7.3.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.3",
    "cloudinary": "^2.10.1",
    "clsx": "^2.0.0",
    "daisyui": "^4.0.0",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.13.0",
    "lucide-svelte": "0.577.0",
    "svelte": "^5.57.0",
    "ws": "^8.21.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/svelte": "^9.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "astro-eslint-parser": "0.16.3",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "0.31.4",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.1.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "3",
    "typescript": "^5.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "patchedDependencies": {
    "astro@7.3.1": "patches/astro@7.3.1.patch"
  }
}