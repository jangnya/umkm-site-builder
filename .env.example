# Database
DATABASE_URL=postgresql://user:password@host:5432/umkm_site_builder
NEON_API_KEY="your_neon_api_key_here"

# Authentication (BetterAuth)
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars
BETTER_AUTH_URL=your_localhost_url_here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here

# Payments (Xendit)
XENDIT_API_KEY=your-xendit-api-key
XENDIT_PUBLIC_API=
XENDIT_WEBHOOK_SECRET=your-xendit-webhook-secret

# Media Storage (Cloudinary)
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET=your-cloudinary-secret

# Environment
NODE_ENV=development

# Superadmin Data
SEED_SUPERADMIN_NAME="Nama Super Admin"
SEED_SUPERADMIN_EMAIL="email"
SEED_SUPERADMIN_PASSWORD="password"

CRON_SECRET=""
